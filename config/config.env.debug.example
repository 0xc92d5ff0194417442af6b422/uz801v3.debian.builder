# Configuration example for debugging.
# Turns on kernel debug options, debug logs and crash capture. Everything else uses the defaults.

# ===========================================================================
# REQUIRED SETTINGS (set these first)
# ===========================================================================

# Public keys for the admin account, one per line. Only ssh-ed25519 keys are accepted. Required.
ADMIN_SSH_KEYS=""

# Name of the Wi-Fi network. Required when WIFI="yes".
WIFI_SSID=""

# Password of the Wi-Fi network: 8 to 63 characters. Required when WIFI="yes".
WIFI_PASSWORD=""

# Two-letter country code, for example GB. The Wi-Fi driver uses it to choose channels. Required.
WIFI_COUNTRY=""

# ===========================================================================
# ADMIN ACCOUNT AND SSH
# ===========================================================================

# Name of the admin account. It must be a lowercase login name and cannot be root.
ADMIN_USER="admin"

# Password of the admin account. If empty, the build makes a random 24 character password and prints it at the end of the build.
ADMIN_PASSWORD=""

# Members of this group can log in over SSH (sshd AllowGroups).
SSH_GROUP="ssh-user"

# Members of this group can use sudo. The admin account joins this group and SSH_GROUP.
WHEEL_GROUP="wheel"

# Port for sshd. The firewall opens this port on wlan0 and usb0.
SSH_PORT="22"

# Addresses or subnets that can connect, separated by spaces. If empty, every address can connect. If you set a list, add the USB subnet 192.168.254.0/24 so USB login still works.
SSH_ALLOW_FROM=""

# Encryption ciphers that sshd accepts. Change them only if a client cannot use the defaults.
SSHD_CIPHERS="chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com"

# Message authentication codes that sshd accepts.
SSHD_MACS="hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256"

# Key exchange algorithms that sshd accepts.
SSHD_KEX="curve25519-sha256@libssh.org,diffie-hellman-group18-sha512,diffie-hellman-group16-sha512"

# Encryption ciphers that the SSH client on the device uses.
SSH_CIPHERS="chacha20-poly1305@openssh.com,aes256-gcm@openssh.com"

# Message authentication codes that the SSH client on the device uses.
SSH_MACS="hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com"

# Key exchange algorithms that the SSH client on the device uses.
SSH_KEX="curve25519-sha256@libssh.org,diffie-hellman-group18-sha512"

# ===========================================================================
# WI-FI
# ===========================================================================

# yes builds the Wi-Fi drivers, the firmware loader, the wpa_supplicant and iw packages, and the wlan0 network.
# no removes them. The wcnss device tree node is disabled only when WIFI=no and BLUETOOTH=no.
WIFI="yes"

# Fixed Wi-Fi MAC address in the form AA:BB:CC:DD:EE:FF. If empty, the device makes a random address on its first boot.
WIFI_MAC=""

# ===========================================================================
# USB GADGET
# ===========================================================================

# yes builds the USB gadget functions and the gadget tool, and the USB gadget starts at boot.
# no builds no gadget functions. The kernel gets the USB host drivers instead.
USB_GADGET="yes"

# The USB functions the gadget offers:
# rndis: USB network (default). ecm or cdc-ecm: USB network. acm: USB serial port. acm-ecm: serial port and network.
# mass: USB storage. ffs: a user-space function. hid: a human interface device.
USB_GADGET_MODE="rndis"

# Address of the device on the usb0 network interface. The host computer needs an address on the same subnet.
USB_ADDRESS="192.168.254.1/24"

# ===========================================================================
# NETWORK AND FIREWALL
# ===========================================================================

# Extra DNS server. If empty, the device uses the DNS servers from DHCP. A value overrides the DNS servers from DHCP.
DNS_SERVER=""

# Extra IPv4 firewall rules, one rule per line. They are added before COMMIT. Do not add *filter or COMMIT lines.
# The base rules are in device/image/templates/firewall/rules.v4. The IPv6 base rules drop all traffic.
FIREWALL_RULES_V4_EXTRA=""

# Extra IPv6 firewall rules, one rule per line. They are added before COMMIT. Do not add *filter or COMMIT lines.
# The base rules are in device/image/templates/firewall/rules.v6.
FIREWALL_RULES_V6_EXTRA=""

# ===========================================================================
# HARDWARE FEATURES
# ===========================================================================

# yes adds the Bluetooth kernel drivers, the bluez package and the wcnss_bt device tree node.
# no removes them.
BLUETOOTH="no"

# yes adds the modem kernel options and the mpss device tree nodes. It needs the modem firmware (mba.mbn and mpss.mdt) in device/board/firmware/usr/lib/firmware/. The repository does not include that firmware.
MODEM="no"

# yes deletes the device tree nodes that this board does not use.
# no keeps the nodes and disables the GPU, display and video nodes.
TRIM_DTB="no"

# yes turns on kexec and suspend support in the kernel and installs kexec-tools. no turns both off.
# kexec is not tested on this SoC.
KEXEC="yes"

# ===========================================================================
# KERNEL
# ===========================================================================

# build compiles the kernel from the source in KERNEL_TAG. This takes a long time.
# prebuilt installs the postmarketOS package from KERNEL_APK_URL instead.
KERNEL_SOURCE="build"

# yes applies device/kernel/minimal-kernel.txt, which turns off most drivers.
# no uses the base config without that list.
MINIMAL_KERNEL="no"

# Path to a custom options file. Each line is CONFIG_X=value or # CONFIG_X is not set. The build applies it after the minimal list. If empty, no custom file is used.
KERNEL_OPTIONS=""

# yes turns on kernel debug options (DEBUG_KERNEL, DYNAMIC_DEBUG, DEBUG_FS, SCHED_DEBUG, PRINTK_TIME), ELF core dumps, and the kernel config in /proc (IKCONFIG). It also keeps the sram device tree node.
# no turns these options off.
KERNEL_DEBUG="yes"

# Number of parallel build jobs. If empty, the build uses the number of CPUs (nproc).
MAKE_JOBS=""

# ===========================================================================
# KERNEL PATCHES
# ===========================================================================

# Applies the BBR v3 TCP congestion control patch (device/kernel/patches/linux/0001-tcp-bbr3-initial-import.patch) and makes BBR the default.
PATCH_BBR="yes"

# Applies the le9uo memory patch (0001-le9uo.patch). It adds the vm.anon_min_ratio and vm.clean_low_ratio sysctls.
PATCH_LE9UO="yes"

# Applies the zstd library update (0001-zstd-cachyos.patch).
PATCH_ZSTD="yes"

# Applies the CPR patch (0001-cpr.patch). It sets the CPU voltage for each frequency and adds the 1094400, 1152000 and 1209600 kHz frequencies. The patch is experimental.
PATCH_CPR="yes"

# Applies the SMSM fix (0001-smsm-skip-empty-mboxes.patch). It skips empty mailbox entries in the SMSM driver.
PATCH_SMSM="yes"

# ===========================================================================
# ROOT FILESYSTEM AND BOOT
# ===========================================================================

# Root filesystem type: ext4, btrfs or xfs. The first boot grows the filesystem to fill its partition.
ROOT_FS="ext4"

# Compression for a btrfs root: none, lzo, zlib or zstd. It works only with ROOT_FS=btrfs.
# Any value except none adds rootflags=compress=... to the kernel command line.
BTRFS_COMPRESS="none"

# Compression level. zstd: 1 to 15. zlib: 1 to 9. If empty, the default level is used. lzo has no level, so leave it empty for lzo.
BTRFS_COMPRESS_LEVEL=""

# Size of the root image in bytes (default 1.5 GiB). Set it slightly above the rootfs.bin data size to shorten the flash of the rootfs partition.
ROOTFS_SIZE="1610612736"

# Size of the boot image in bytes. The maximum is 67108864 (64 MiB), the size of the boot partition.
BOOT_SIZE="67108864"

# Kernel command line options. The build adds the Wi-Fi regulatory domain and the root filesystem options.
BOOT_ARGS="no_framebuffer=true cma=4M rw rootwait"

# ===========================================================================
# CPU
# ===========================================================================

# CPU frequency governor. cpu-governor.service sets it on all cores at boot.
CPU_GOVERNOR="schedutil"

# Maximum CPU frequency in kHz. The four cores share one clock, so the limit applies to all of them. If empty, there is no limit.
# Steps without PATCH_CPR: 200000, 400000, 533333, 800000, 998400. With PATCH_CPR=yes, also 1094400, 1152000 and 1209600. Example: 998400.
CPU_MAX_FREQ=""

# Cores that stay online, separated by spaces (0 to 3). Core 0 must be listed. The other cores are taken offline at boot. If empty, all cores stay online. Example: "0 1".
CPU_ACTIVE_CORES=""

# ===========================================================================
# MEMORY AND SWAP
# ===========================================================================

# yes adds the zram driver, the zram-swap service and a compressed swap device in RAM.
# no removes the driver and the service. The zram sysctl file stays in place.
ZRAM="yes"

# Size of the zram swap as a percentage of RAM. Used only with ZRAM=yes.
ZRAM_PERCENT="50"

# Size of /tmp, a tmpfs, as a percentage of RAM.
TMP_SIZE="10%"

# ===========================================================================
# LEDS
# ===========================================================================

# Trigger for the red LED (power). activity turns it on with CPU activity.
LED_RED_TRIGGER="activity"

# Trigger for the green LED. netdev follows Wi-Fi receive and transmit on wlan0.
LED_GREEN_TRIGGER="netdev"

# Trigger for the blue LED. mmc0 follows eMMC activity.
LED_BLUE_TRIGGER="mmc0"

# ===========================================================================
# SERVICES AND PACKAGES
# ===========================================================================

# Units that are masked at first boot, separated by spaces. A masked unit cannot start.
MASK_SERVICES="getty@tty1.service e2scrub_reap.service networking.service systemd-pstore.service suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target"

# Units that are enabled at first boot, separated by spaces. The build removes wpa_supplicant@wlan0.service when WIFI=no.
ENABLE_SERVICES="systemd-networkd.service systemd-resolved.service systemd-timesyncd.service wpa_supplicant@wlan0.service"

# Extra Debian packages to install, separated by spaces. The build also adds packages for the enabled features, for example bluez for BLUETOOTH and kexec-tools for KEXEC.
EXTRA_PACKAGES=""

# yes installs the watchdog daemon and enables it at boot. The daemon reboots the device when it stops feeding the watchdog for 60 seconds. The timeout and interval are in device/image/overlay/watchdog/etc/watchdog.conf. no installs nothing.
WATCHDOG="no"

# ===========================================================================
# LOGGING AND DEBUGGING
# ===========================================================================

# Where the journal is kept. disk keeps it on the eMMC across reboots. ram keeps it in memory only. none turns the journal off.
LOG_STORAGE="disk"

# How much the journal stores. full: debug and above. normal: info and above. minimal: warnings and errors. none: emergency messages only.
LOG_LEVEL="full"

# Maximum size of the stored journal, for example 50M.
LOG_MAX_SIZE="50M"

# yes starts a new journal file each day, so each day is kept as its own archived file. The archived files are copied to /var/backups/logs once a day, compressed with gzip. no keeps the current file until it reaches its size limit.
LOG_ARCHIVE="yes"

# Number of journal files to keep. When there are more, the oldest files are deleted first. Whole number, 1 or more.
LOG_ARCHIVE_COUNT="30"

# yes sends the journal over TCP to LOG_FORWARD_TARGET. The forwarding starts after the network is online.
LOG_FORWARD="no"

# Address of the log receiver as host:port. Used only with LOG_FORWARD=yes.
LOG_FORWARD_TARGET=""

# yes writes the sudo command log to /var/log/sudo.log.
LOG_SUDO="yes"

# yes makes systemd write debug-level messages.
DEBUG_SERVICES="yes"

# yes reserves RAM for crash logs (pstore and ramoops), so the logs survive a reboot. Required: CRASH_CAPTURE_ADDR and CRASH_CAPTURE_SIZE.
# Check /proc/iomem on the device first, so the reserved area does not overlap other memory.
CRASH_CAPTURE="yes"

# Start address of the reserved RAM, for example 0x9fe00000. Used only with CRASH_CAPTURE=yes.
CRASH_CAPTURE_ADDR="0x9fe00000"

# Size of the reserved RAM, for example 0x100000 (1 MiB). Used only with CRASH_CAPTURE=yes.
CRASH_CAPTURE_SIZE="0x100000"

# ===========================================================================
# SYSTEM
# ===========================================================================

# Host name. If empty, the build uses a random name in the form debian-XXXXXXXX.
HOST_NAME=""

# Machine ID: 32 lowercase hex characters. If empty, systemd creates one on the first boot.
MACHINE_ID=""

# Time zone as Area/Zone. The list is in /usr/share/zoneinfo.
TIMEZONE="Etc/UTC"

# System locale with its charset, for example en_GB.UTF-8.
LOCALE="en_GB.UTF-8"

# Time servers, separated by spaces. If empty, systemd-timesyncd uses its default servers.
NTP_SERVERS=""

# Debian release for the image.
RELEASE="stable"

# Time of day (HH:MM) for the automatic security upgrade.
UPGRADE_TIME="03:00"

# Random delay added to UPGRADE_TIME (systemd RandomizedDelaySec).
UPGRADE_DELAY="30min"

# Apt suite for security upgrades. If empty, the build uses RELEASE-security, for example stable-security.
SECURITY_SUITE=""

# ===========================================================================
# ADVANCED: SOURCES AND BOARD VALUES (change only when needed)
# ===========================================================================

# Debian package mirror used by debootstrap and apt.
DEBIAN_MIRROR="https://deb.debian.org/debian"

# Kernel source tag. Changing it changes the kernel version. Change KERNEL_SRC_URL and KERNEL_SRC_SHA512 with it.
KERNEL_TAG="linux-6.12.118"

# Kernel source tarball. The build checks it against KERNEL_SRC_SHA512.
KERNEL_SRC_URL="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.12.118.tar.xz"

# SHA-512 of the kernel source tarball.
KERNEL_SRC_SHA512="2f3a7a45db7af4a2af2d08e56e6e587c5b7e08427bf11b78bdde005ad91886debad2e24edd75e28652e0e6589f8b8408edb41281372db04cc11428a5442c71e1"

# postmarketOS commit that holds the base kernel config.
KERNEL_CONFIG_COMMIT="5832e3453ab7ec4483b1f6c6479b5bd45985e4d7"

# SHA-512 of the base kernel config file.
KERNEL_CONFIG_SHA512="67b6141ad2d3634177194a1ae58f08566a9dd33936c9a5d429bad785320c7b9bf1c676ba1cedf438d235413195fb15236867ccfc3310cf5a77a4bce4781fb8e4"

# Kernel package used when KERNEL_SOURCE=prebuilt.
KERNEL_APK_URL="https://mirror.postmarketos.org/postmarketos/v24.06/aarch64/linux-postmarketos-qcom-msm8916-6.6-r5.apk"

# SHA-256 of the file at KERNEL_APK_URL. Change both together.
KERNEL_SHA256="8166387eaca9189ff923e635857afb272886b433925a1a7a172d4ed2bab4baa9"

# Qualcomm bootloader zip used in step 40. The build stores it in work/downloads/ and reuses it.
FW_URL="https://archive.org/download/dragonboard-410c-bootloader-emmc-linux-176/dragonboard-410c-bootloader-emmc-linux-176.zip"

# SHA-256 of the file at FW_URL.
FW_SHA256="a37c4e82a970ae2350fcfc7180559caf1dc3928e7c169316fe4ab899b7d305ad"

# Board compatible string for the UZ801 v3. Change it only for another board.
BOARD_COMPATIBLE="yiming,uz801-v3"

# Device tree that lk2nd bundles. Change it only for another board.
LK2ND_BUNDLE_DTB="msm8916-512mb-mtp.dtb"

# Device tree file that the kernel build installs. Change it only for another board.
DTB_NAME="msm8916-yiming-uz801v3.dtb"
