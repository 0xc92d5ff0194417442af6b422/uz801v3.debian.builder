/delete-node/ &{/thermal-zones/modem-thermal};
/delete-node/ &bimc;
/delete-node/ &pcnoc;
/delete-node/ &snoc;
/delete-node/ &{/soc@0/sram@290000};
/delete-node/ &{/reserved-memory/reserved@86680000};

// all LEDs start off
&led_r {
	default-state = "off";
};
&led_g {
	default-state = "off";
};
&led_b {
	default-state = "off";
};
