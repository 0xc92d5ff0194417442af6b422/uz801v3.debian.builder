[Unit]
Description=Show boot progress: blue LED after basic system start
DefaultDependencies=no
After=basic.target
Before=multi-user.target

[Service]
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectHome=yes
Type=oneshot
ExecStart=/usr/sbin/led-boot.sh progress red:power

[Install]
WantedBy=multi-user.target
