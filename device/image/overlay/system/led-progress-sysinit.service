[Unit]
Description=Show boot progress: green LED after system init
DefaultDependencies=no
After=sysinit.target
Before=basic.target

[Service]
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectHome=yes
Type=oneshot
ExecStart=/usr/sbin/led-boot.sh progress blue:wan

[Install]
WantedBy=basic.target
