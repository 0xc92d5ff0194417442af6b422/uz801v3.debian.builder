PARTUUID=@BOOT_PARTUUID@	/boot	ext2	defaults,nosuid,noexec,nodev	1 2

none /proc proc rw,nosuid,nodev,noexec,relatime,hidepid=2,gid=0 0 0
none /dev/shm tmpfs rw,nosuid,nodev,noexec,size=8M 0 0

/home    /home      none    defaults,bind,nosuid,noexec,nodev    0 0
/var     /var       none    defaults,bind,nosuid                 0 0
